cabal-version: 3.0
name: born2flap-math
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      Born2Flap.Math.Types
      Born2Flap.Math.Control
      Born2Flap.Math.Wing
      Born2Flap.Math.Planform
      Born2Flap.Math.Section
      Born2Flap.Math.Structure
      Born2Flap.Math.Model
      Born2Flap.Math.Json
      Born2Flap.Math.B2fModel
      Born2Flap.Math.B2fPackage
      Born2Flap.Math.ModelCatalog
      Born2Flap.Math.Waveform
      Born2Flap.Math.Vehicle
      Born2Flap.Math.Firmware
      Born2Flap.Math.Servo
      Born2Flap.Math.Airframe
      Born2Flap.Math.RollDynamics
      Born2Flap.Math.SpatialDynamics
      Born2Flap.Math.LiftField
      Born2Flap.Math.FirmwareVehicle
      Born2Flap.Math.FerocityPrice
      Born2Flap.Math.PhaseEnvelope
      Born2Flap.Math.ResponsePhase
      Born2Flap.Math.Simulation
  hs-source-dirs: src
  build-depends:
      base >=4.17 && <5
    , directory
    , filepath
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -O2

foreign-library born2flap_math
  type: native-shared
  if os(windows)
    options: standalone
    ghc-options: -optl-Wl,--export-all-symbols
  else
    ghc-options: -dynamic
  other-modules:
      Born2Flap.Math.FFI
      Born2Flap.Math.Simulation
      Born2Flap.Math.Types
      Born2Flap.Math.Vehicle
      Born2Flap.Math.Wing
      Born2Flap.Math.Planform
      Born2Flap.Math.Section
      Born2Flap.Math.Structure
      Born2Flap.Math.Model
      Born2Flap.Math.Json
      Born2Flap.Math.B2fModel
      Born2Flap.Math.ModelCatalog
      Born2Flap.Math.Waveform
      Born2Flap.Math.Firmware
      Born2Flap.Math.Servo
      Born2Flap.Math.Airframe
      Born2Flap.Math.RollDynamics
      Born2Flap.Math.SpatialDynamics
      Born2Flap.Math.LiftField
      Born2Flap.Math.FirmwareVehicle
      Born2Flap.Math.PhaseEnvelope
      Born2Flap.Math.ResponsePhase
  c-sources: cbits/bridge.c
  hs-source-dirs: src
  build-depends: base >=4.17 && <5
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -O2

executable born2flap-export-models
  main-is: Main.hs
  hs-source-dirs: tools/export-models
  build-depends:
      base >=4.17 && <5
    , born2flap-math
    , directory
    , filepath
  default-language: GHC2021

test-suite math-properties
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base >=4.17 && <5, born2flap-math
  default-language: GHC2021

executable born2flap-yaw-probe
  main-is: YawProbe.hs
  hs-source-dirs: test
  build-depends: base >=4.17 && <5, born2flap-math
  default-language: GHC2021
  ghc-options: -O1

