      .hero-brush-character 翼
      .hero-brush-character.hero-brush-character--2 心
    .hero-bird{"aria-hidden" => "true"}
      %pre
        :preserve
                    _..--=--.._
                .-'`      _     `'-.
              .'        (_)        '.
             /    _,.--`   `--.,_    \
            |   /    \       /    \   |
            |  /      \     /      \  |
            \  \      /     \      /  /
             \  '._  /       \  _.'  /
              '.   `'---------`'   .'
                '-._         _.-'
                    `'-----'`

    %nav#nav
      .nav-inner
        %a.home-link{href: "#", onclick: "majesticScroll(); return false;", title: nav_home}
          %span.wm BORN
          %span.wm.wm-brush 2
          %span.wm FLAP
        .nav-links#nav-links
          %a{href: "#essence"}!= nav_essence
          %a{href: "#flight"}!= nav_flight
          %a{href: "#architecture"}!= nav_architecture
          %a{href: "#gameplay"}!= nav_gameplay
          %a{href: "#open"}!= nav_open
          %a{href: "#support"}!= nav_support
          %span.nav-sep
          %a{href: "#{asset_prefix}#{lang_dir}tutorials/"}!= nav_tutorials
          %a{href: "#{asset_prefix}#{lang_dir}documentation/"}!= nav_documentation
        %button.nav-toggle{type: "button", "aria-label" => "Menu", "aria-expanded" => "false", "aria-controls" => "nav-links"}
          %span
          %span
          %span

    %header#header
      .hero-content
        %p.hero-kicker!= hero_kicker
        %h1.wordmark
          %span.wm!= hero_title_a
          %span.wm.wm-brush!= hero_title_b
          %span.wm!= hero_title_c
        %p.hero-subhead!= hero_subhead
        %p.hero-greeting!= hero_greeting
        %p.hero-lead!= hero_lead
        .hero-cta
          %a.cta.cta-primary{href: "https://github.com/dantiel/BORN-2-FLAP", target: "_blank", rel: "noopener"}!= hero_cta_source
          %a.cta.cta-secondary{href: "https://store.steampowered.com/", target: "_blank", rel: "noopener"}!= hero_cta_steam
          %a.cta.cta-ghost{href: "https://store.epicgames.com/", target: "_blank", rel: "noopener"}!= hero_cta_epic
        %p.hero-version!= hero_version

    %main
