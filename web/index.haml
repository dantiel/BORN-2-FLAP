        %p.lead!= arch_lead
        %dl.grid
          %dt!= arch_haskell_title
          %dd!= arch_haskell_desc
          %dt!= arch_unreal_title
          %dd!= arch_unreal_desc
          %dt!= arch_bridge_title
          %dd!= arch_bridge_desc
