        %a{href: lang_href_en, class: lang_class_en} EN
        %a{href: lang_href_de, class: lang_class_de} DE
        %a{href: lang_href_es, class: lang_class_es} ES
        %a{href: lang_href_fr, class: lang_class_fr} FR
        %a{href: lang_href_zh, class: lang_class_zh} 中文
        %a{href: lang_href_ja, class: lang_class_ja} 日本語
        %a{href: lang_href_ko, class: lang_class_ko} 한국어
        %a{href: lang_href_ru, class: lang_class_ru} RU
      %p.footer-links
        %a{href: "https://github.com/dantiel/BORN-2-FLAP", target: "_blank", rel: "noopener"}!= footer_github
        %span.sep ·
        %a{href: "https://ko-fi.com/darographix", target: "_blank", rel: "noopener"}!= footer_kofi
        %span.sep ·
        %a{href: "https://github.com/sponsors/dantiel", target: "_blank", rel: "noopener"}!= footer_sponsors
        %span.sep ·
        %a{href: "https://store.steampowered.com/", target: "_blank", rel: "noopener"}!= footer_steam
        %span.sep ·
        %a{href: "https://store.epicgames.com/", target: "_blank", rel: "noopener"}!= footer_epic
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}tutorials/"}!= footer_tutorials
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}documentation/"}!= footer_docs
      %p.footer-hermetic!= footer_hermetic
      %p.footer-credit
        != footer_credit
        %a.brand-script{href: "https://darographix.de", target: "_blank", rel: "noopener"}darographix

    %button.scroll-top{onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label" => "Scroll to top"} ↑

    :javascript
      const nav = document.querySelector('#nav');
      const navToggle = document.querySelector('.nav-toggle');
      const navLinks = document.querySelector('#nav-links');
      const scrollBtn = document.querySelector('.scroll-top');
      const bird = document.querySelector('.hero-bird');
      const bg = document.querySelector('.hero-bg');

      if (navToggle) {
        navToggle.addEventListener('click', () => {
          const open = navToggle.getAttribute('aria-expanded') === 'true';
          navToggle.setAttribute('aria-expanded', String(!open));
          navLinks.classList.toggle('open', !open);
        });
        navLinks.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            navToggle.setAttribute('aria-expanded', 'false');
            navLinks.classList.remove('open');
          });
        });
      }

      function majesticScroll() {
        const start = window.scrollY;
        const duration = 1600;
        const startTime = performance.now();
        function step(now) {
          const elapsed = now - startTime;
          const t = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - t, 4);
          window.scrollTo(0, start * (1 - eased));
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      function tick() {
        const scroll = window.scrollY;
        const vh = window.innerHeight;
        const t = Math.min(scroll / vh, 1);

        if (bird) {
          bird.style.transform = `translateY(${t * 140}px)`;
          bird.style.opacity = Math.max(0, 1 - t * 1.6);
        }
        if (bg) bg.style.setProperty('--scroll', t.toFixed(3));
        nav.classList.toggle('scrolled', scroll > 40);
        scrollBtn.classList.toggle('visible', scroll > vh * 0.6);

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);