            %td!= flight_spec_wings_label
            %td!= flight_spec_wings_val
          %tr
            %td!= flight_spec_span_label
            %td!= flight_spec_span_val
          %tr
            %td!= flight_spec_chord_label
            %td!= flight_spec_chord_val
          %tr
            %td!= flight_spec_stall_label
            %td!= flight_spec_stall_val
          %tr
            %td!= flight_spec_crossflow_label
            %td!= flight_spec_crossflow_val
          %tr
            %td!= flight_spec_structure_label
            %td!= flight_spec_structure_val
          %tr
            %td!= flight_spec_wave_label
            %td!= flight_spec_wave_val
          %tr
            %td!= flight_spec_step_label
            %td!= flight_spec_step_val

      %section#architecture
