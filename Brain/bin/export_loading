#!/usr/bin/env ruby
# Compile the thread-safe movie-player view using the same template/theme pipeline.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'born2flap'
require 'json'
view = Born2Flap::UI::Views::Loading.render(:screen)
File.write(ARGV.fetch(0), JSON.generate(Born2Flap::UI::UMGEmitter.emit(view)), encoding: 'UTF-8')
