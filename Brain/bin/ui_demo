#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "born2flap"
require "json"

HUD = <<~HAML
  %Overlay{ id: "HUD" }
    %VBox
      %Text{ bind: "title" }
        = "BORN-2-FLAP"
      %Slider{ bind: "throttle", min: 0, max: 100 }
      %Button{ onPress: "toggle_flap", class: "primary" }
        = "FLAP"
HAML

tree = Born2Flap::UI::HamlParser.parse(HUD)

puts "=== UMG (JSON → Unreal) ==="
puts JSON.pretty_generate(Born2Flap::UI::UMGEmitter.emit(tree.children.first))
puts

puts "=== HTML (Web) ==="
puts Born2Flap::UI::HtmlEmitter.emit(tree.children.first)
puts

puts "=== React Native (JSX) ==="
puts Born2Flap::UI::RNEmitter.emit(tree.children.first)
puts

# Ruby-way reactive root (no Redux): reconcile a changed tree → minimal patch.
bus = Born2Flap::EventBus.new
root = Born2Flap::UI::Root.new(bus: bus)
bus.subscribe(:ui_patch) do |payload|
  puts "  [ui_patch] #{payload[:patch].map { |op| op[:op] }.inspect}"
end

puts "=== Reconcile (live propagation, no Redux) ==="
t1 = Born2Flap::UI::HamlParser.parse(HUD)
t2 = Born2Flap::UI::HamlParser.parse(HUD.sub("min: 0, max: 100", "min: 0, max: 100, value: 42"))

root.render(t1)   # mount → :replace
bus.drain

root.render(t2)   # only the changed slider value propagates → :update_props
bus.drain

root.render(t2)   # identical tree → no patch at all
bus.drain
puts "  (third render: no change → no patch)"
