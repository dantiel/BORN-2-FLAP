#!/usr/bin/env ruby
# frozen_string_literal: true
# umghaml_brain — the permanent Ruby Brain process that drives the UMG host.
#
#   ruby bin/umghaml_brain <telemetry.ndjson|-> <frames.ndjson|-> [--ticks N] [--interval S]
#
# Reads telemetry (one JSON object per line, overwritten each game tick by the
# C++ bridge), authors the full dashboard (cockpit + radio + menu/poi/settings/
# rc/channels/splash overlays) in UMGHAML, reconciles against the previous tree,
# and writes the minimal NDJSON op stream to the frames sink. The C++ host
# (Born2FlapUIBridge) tails the frames sink and applies each frame; it is the
# writer of the telemetry source. This file is the "always-on" loop that makes
# UMGHAML the live authoring path instead of a build-time grammar.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "born2flap"
require "json"
require "born2flap/ui/session"

telemetry_path = ARGV[0]
frames_path    = ARGV[1]

ticks    = nil
interval = 0.025
idx = 2
while idx < ARGV.length
  case ARGV[idx]
  when "--ticks"    then ticks = ARGV[idx + 1].to_i; idx += 2
  when "--interval" then interval = ARGV[idx + 1].to_f; idx += 2
  else idx += 1
  end
end

TRUNCATE_AT = 8 * 1024 * 1024  # rotate the frames file; remount resyncs the host

def read_telemetry(path)
  return nil if path.nil? || path == "-"
  text = File.read(path, encoding: 'UTF-8')
  return nil if text == @last_telemetry_text
  parsed = JSON.parse(text, symbolize_names: true)
  @last_telemetry_text = text
  parsed
rescue Errno::ENOENT, Errno::EACCES, JSON::ParserError
  nil # a rename can briefly make the snapshot unavailable; keep the last UI
end

def open_sink(path)
  return $stdout if path.nil? || path == "-"
  io = File.open(path, "ab")
  io.sync = true
  io
end

sink = open_sink(frames_path)
brain = Born2Flap::Brain.new
session = Born2Flap::UI::Session.new(brain)
bus = brain.bus
root = Born2Flap::UI::Root.new(bus: bus)
transport = Born2Flap::UI::Transport.new(bus: bus, io: sink)

current_tree = nil
telemetry = nil
frames_bytes = 0
iteration = 0
last_visual = nil

loop do
  raw = read_telemetry(telemetry_path)
  telemetry = session.update(raw) if raw

  if raw || current_tree.nil?
    brain.tick(telemetry)
    screen = brain.view_model[:screen]
    visual = (telemetry || {}).reject { |key, _| key == :ui_events }
    visual_key = [screen, visual]
    if visual_key != last_visual
      current_tree = Born2Flap::UI::Dashboard.build(visual, screen: screen)
      root.render(current_tree)
      last_visual = visual_key
    end
  end
  frames_bytes += transport.flush

  # Bounded growth: after truncation the host's tail offset is stale, so remount
  # the full tree (a create_instance at []) to re-sync its widget index.
  if frames_path && frames_path != "-" && frames_bytes > TRUNCATE_AT
    sink.close
    File.open(frames_path, "wb") {} # truncate
    sink = File.open(frames_path, "ab")
    sink.sync = true
    transport.replace_io(sink)
    root = Born2Flap::UI::Root.new(bus: bus)
    frames_bytes = 0
    root.render(current_tree)
    frames_bytes += transport.flush
  end

  iteration += 1
  break if ticks && iteration >= ticks
  sleep interval
end

sink.close unless sink == $stdout