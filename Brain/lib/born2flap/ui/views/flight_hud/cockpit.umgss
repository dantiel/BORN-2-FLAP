// cockpit.umgss — presentation tokens for the glass cockpit.
//
// Declares *semantic* style tokens, not pixels. The C++ host resolves these in
// Born2FlapUiTheme.h (size → font px, spacing → layout gap). The Brain stays
// behaviour + intent; styling is declared here and rendered by the thin layer.

$panel-space: 2     // spacing token (layout gap scale)
$brand-size: xxl    // typography scale token

Banner#brand
  size: $brand-size

Panel
  spacing: $panel-space

Stat
  size: m

Gauge
  size: m
