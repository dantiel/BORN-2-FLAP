%Overlay{ align: "left", valign: "top" }
  %VBox{ spacing: 8 }
    %Banner{ text: "#{t('hangar.title')}", tone: "accent" }

    %Section{ title: "#{t('hangar.silhouette')}", open: true }
      %Field{ label: "#{t('hangar.bird')}" }
        %Select{ value: #{bird_model}, options: #{bird_options}, action: "bird.select" }
      %Field{ label: "#{t('hangar.flight_profile')}" }
        %Select{ value: #{profile_index}, options: #{profile_options}, action: "profile.select" }

    %Section{ title: "#{t('hangar.servo')}", open: true }
#{servo_rows}

    %Section{ title: "#{t('hangar.battery')}", open: false }
#{battery_rows}

    %Section{ title: "#{t('hangar.geometry')}", open: false }
#{geometry_rows}

    %Section{ title: "#{t('hangar.authority')}", open: false }
#{authority_rows}

    %Button{ label: "#{t('hangar.save')}", action: "editor.close", tone: "good" }
