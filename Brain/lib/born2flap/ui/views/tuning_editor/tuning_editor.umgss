// tuning_editor.umgss — presentation tokens for the hangar editor.
//
// Declares *semantic* style tokens (size / spacing), not pixels. The C++ host
// resolves these in Born2FlapUiTheme.h. The Brain stays behaviour + intent.

$field-space: s     // spacing token (layout gap scale)

Banner
  size: l

Section
  spacing: 2

Field
  spacing: $field-space

ScrollPage
  safe_top: 145
  safe_bottom: 80
  edge: 0.24
  edge_bottom: 0.15
