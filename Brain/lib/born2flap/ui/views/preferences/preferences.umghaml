%Panel{ padding: 24 }
  %ScrollPage{}
    %VBox{ spacing: 12 }
      %Caption{ title: "#{t('settings.title')}" }
      %Segment{ options: ["#{t('settings.general')}", "#{t('settings.audio')}", "#{t('settings.control')}", "#{t('settings.key_bindings')}"], value: #{page}, action: "preferences.page" }
    %VBox{ spacing: 18 }
      - if page == 0
        %Dropdown{ label: "#{t('settings.language')}", options: ["English", "Deutsch", "Español", "Français", "Italiano", "Português", "Norsk", "العربية", "हिन्दी", "日本語", "한국어", "Русский", "中文"], value: #{%w[en de es fr it pt no ar hi ja ko ru zh].index(lang) || 0}, action: "language.set" }
        %Select{ label: "#{t('settings.graphics_quality')}", options: ["LOW", "MEDIUM", "HIGH", "EPIC"], value: #{graphics_quality}, action: "graphics.quality", tooltip: "Lower tiers reduce lighting and volumetric effects. Hardware features depend on GPU support." }
        %Toggle{ label: "#{t('settings.airborne_camera')}", value: #{camera_fpv}, on: "FPV", off: "CHASE", action: "camera.fpv" }
        %Slider{ label: "#{t('settings.fpv_camera_angle')}", value: #{fpv_angle}, min: -45, max: 45, step: 1, unit: "°", action: "camera.angle" }
        %Toggle{ label: "#{t('settings.invert_free_look')}", value: #{freelook_invert}, action: "camera.freelook.invert" }
        %TextBlock{ text: "DISPLAY / CAMERA", tone: "accent", size: "s" }
        %Dropdown{ label: "WINDOW MODE", options: ["FULLSCREEN", "BORDERLESS", "WINDOWED"], value: #{display_mode}, action: "display.mode" }
        %Toggle{ label: "FOLLOW SYSTEM RESOLUTION", value: #{display_follow_system}, on: "ON", off: "OFF", action: "display.follow_system" }
        %Dropdown{ label: "RESOLUTION", options: ["NATIVE", "3840×2160", "2560×1440", "1920×1080", "1600×900", "1366×768", "1280×720"], value: #{display_resolution}, action: "display.resolution" }
        %TextBlock{ text: "PILOT AVATAR", tone: "accent", size: "s" }
        %Toggle{ label: "SHOW ON-FOOT PILOT", value: #{avatar_enabled}, on: "ON", off: "OFF", action: "avatar.enabled" }
        %Dropdown{ label: "PILOT", options: ["John", "Erika", "Amy", "Michelle", "Sophie", "Kate", "James", "Adam", "Brian", "Alex"], value: #{avatar_person}, action: "avatar.person" }
        %TextBlock{ text: "GAMEPLAY", tone: "accent", size: "s" }
        %Toggle{ label: "TRICK TOASTS", value: #{trick_toasts}, on: "ON", off: "OFF", action: "trick.toasts", tooltip: "Pop-up call-outs for handcatches and aerobatics (looping, barrel roll, inverted, skim)." }
      - if page == 1
        %Slider{ label: "#{t('settings.wingbeat_volume')}", value: #{wingbeat_volume}, min: 0, max: 4, step: 0.05, action: "audio.wingbeat", tooltip: "Changes wingbeat audio only; wind and surf are unaffected." }
        %Slider{ label: "#{t('settings.radio_volume')}", value: #{radio_volume}, min: 0, max: 1, step: 0.05, action: "radio.volume" }
        %Slider{ label: "#{t('settings.footsteps_volume')}", value: #{footstep_volume}, min: 0, max: 1, step: 0.05, action: "audio.footsteps", tooltip: "#{t('settings.footsteps_help')}" }
      - if page == 2
        %TextBlock{ text: "#{t('tuning.controls')}", tone: "accent", size: "s" }
        - %w[axis.roll axis.pitch axis.yaw].each_with_index do |key, i|
          %Slider{ label: "#{t(key)}", value: #{mouse_gains[i]}, min: -2, max: 2, step: 0.05, action: "mouse.gain.#{i}" }
        %Button{ label: "#{t('tuning.reset_mouse')}", action: "mouse.reset" }
        %Slider{ label: "#{t('tuning.control_expo')}", value: #{control_expo}, min: 0, max: 100, step: 1, unit: "%", action: "control.expo" }
        %Slider{ label: "#{t('tuning.mouse_speed')}", value: #{speed_modifier}, min: 0, max: 1, step: 0.05, action: "mouse.speed" }
        %TextBlock{ text: "#{t('tuning.assist')}", tone: "accent", size: "s" }
        %Slider{ label: "#{t('tuning.flight_safety')}", value: #{flight_safety}, min: 0, max: 2, step: 1, action: "flight.safety" }
        %Toggle{ label: "#{t('tuning.replay_shadows')}", value: #{replay_spirits}, action: "replay.spirits" }
        %Toggle{ label: "#{t('tuning.trick_toasts')}", value: #{trick_toasts}, action: "trick.toasts" }
        %Button{ label: "#{t('tuning.delete_replay')}", action: "replay.delete", disabled: #{frontend}, tooltip: "Deletes replay shadows in the loaded world." }
      - if page == 3
        %TextBlock{ text: "#{t('settings.key_hint')}", size: "s", wrap: true }
        - keybindings.each do |binding|
          %Field{ label: #{binding[:label].inspect} }
            %KeySelector{ key: #{binding[:key].inspect}, action: "keybind.#{binding[:id]}" }
        %Button{ label: "#{t('settings.restore_defaults')}", action: "keybind.reset" }
    %Button{ label: "#{t('menu.back')}", action: "preferences.close" }
