%Overlay{ align: "right", valign: "bottom", margin: 20 }
  %SizeBox{ width: 400 }
    %Panel{ bg: "solid", padding: 14 }
      %HBox{ spacing: 12, valign: "center" }
        %SizeBox{ width: 96, height: 96 }
          %Image{ texture: "#{radio_cover}" }
        %VBox{ spacing: 4 }
          %Banner{ text: #{radio_station.inspect}, tone: "accent", size: "s" }
          %TextBlock{ text: #{radio_track.inspect}, tone: "dim", size: "xs" }
          %HBox{ spacing: 8 }
            %Button{ label: "#{play_icon}", action: "#{play_action}", tooltip: "#{t('radio.play_tooltip')}" }
            %Slider{ value: #{radio_volume}, min: 0, max: 1, step: 0.05, action: "radio.volume", tooltip: "#{t('radio.volume_tooltip')}" }