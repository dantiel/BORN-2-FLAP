%Overlay{ align: "center", valign: "center" }
  %SizeBox{ width: 960, height: 700 }
    %Panel{ title: "#{world_title}", padding: 28 }
      %Segment{ options: ["LOCATION", "WEATHER & TIME"], value: #{page}, action: "menu.page", tooltip: "Browse a world, then choose the conditions for your flight.", margin: [0, 0, 0, 14] }
      %TextBlock{ text: "WORLD #{world_position} OF #{world_count}", size: "xs", align: "center", tone: "dim" }
      %ScrollBox{ pad: 30, margin: [0, 10, 0, 16] }
        %VBox{ visible: #{page == 0}, spacing: 14 }
          %SizeBox{ width: 350, height: 190 }
            %Image{ texture: "/Game/UI/Elements/#{artwork}.#{artwork}" }
          %TextBlock{ text: "#{world_story}", size: "m", wrap: true }
        %VBox{ visible: #{page == 1}, spacing: 14 }
          %Select{ label: "WEATHER", value: #{weather_index}, options: #{weathers}, action: "weather.#{world_id}" }
          %Select{ label: "TIME OF DAY", value: #{time_index}, options: #{times}, action: "daytime.#{world_id}" }
          %Section{ title: "WIND", open: true }
            %Field{ label: "DIRECTION" }
              %Slider{ value: #{wind_dir}, min: 0, max: 360, step: 5, unit: "°", action: "wind.dir" }
            %Field{ label: "STRENGTH" }
              %Slider{ value: #{wind_speed}, min: 0, max: 5, step: 0.1, unit: "×", action: "wind.speed" }
            %Field{ label: "GUSTS" }
              %Slider{ value: #{wind_gust}, min: 0, max: 8, step: 0.1, unit: "×", action: "wind.gust" }
            %Field{ label: "RANDOMNESS" }
              %Slider{ value: #{wind_random}, min: 0, max: 8, step: 0.1, unit: "×", action: "wind.random" }
            %Field{ label: "THERMALS" }
              %Slider{ value: #{wind_thermal}, min: 0, max: 5, step: 0.1, unit: "×", action: "wind.thermal" }
            - if wind_custom
              %Button{ label: "RESET WIND TO WEATHER DEFAULT", action: "wind.reset", tone: "dim" }
      %HBox{ spacing: 12 }
        %Button{ label: "PREV", action: "menu.prevWorld", tooltip: "Browse the previous world." }
        %Button{ label: "FLY  #{world_title}", action: "menu.#{world_id.downcase}", tone: "good", tooltip: "Start a flight with the selected weather and time." }
        %Button{ label: "NEXT", action: "menu.nextWorld", tooltip: "Browse the next world." }
      - if menu_inlevel
        %Button{ label: "RESUME", action: "menu.resume", tone: "good", margin: [0, 10, 0, 0] }
        %Button{ label: "FLIGHT DESK", action: "menu.settings", margin: [0, 8, 0, 0] }
        %Button{ label: "CONTROLS", action: "menu.controls", margin: [0, 8, 0, 0] }
      %Button{ label: "QUIT", action: "menu.quit", tone: "dim", margin: [0, 14, 0, 0] }