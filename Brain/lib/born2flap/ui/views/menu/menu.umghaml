%Panel{ padding: 24 }
  %ScrollPage{}
    - if world_stage == 0
      %VBox{ spacing: 8 }
        %Caption{ title: "#{t('menu.maps')}" }
        %HBox{ spacing: 12, valign: "center" }
          %Button{ label: "#{t('menu.prev')}", action: "menu.prevWorld", tone: "dim" }
          %TextBlock{ text: "#{world_position} / #{world_count}", tone: "dim", size: "s" }
          %Button{ label: "#{t('menu.next')}", action: "menu.nextWorld", tone: "dim" }
      %VBox{ spacing: 12 }
        - worlds.each_with_index do |w, i|
          %HBox{ spacing: 14 }
            %SizeBox{ width: 168, height: 94 }
              %Image{ texture: "/Game/UI/Elements/#{w[:art]}.#{w[:art]}" }
            %SizeBox{ width: 730 }
              %VBox{ spacing: 6 }
                %Button{ label: "#{w[:title]}", action: "menu.pick.#{w[:id].downcase}" }
                %TextBlock{ text: "#{w[:brief]}", size: "s", wrap: true }
      %VBox{ spacing: 4 }
        %TextBlock{ text: "#{t('menu.hint')}", size: "s", wrap: true }
    - else
      %VBox{ spacing: 12 }
        %Caption{ title: "#{world_title}" }
        %HBox{ spacing: 12 }
          - unless apply_mode
            %Button{ label: "#{t('menu.all_maps')}", action: "menu.allWorlds", tone: "dim" }
          %Segment{ options: #{menu_pages}, value: #{page}, action: "menu.page" }
      %VBox{ spacing: 18 }
        %VBox{ visible: #{page == 0}, spacing: 14 }
          %SizeBox{ width: 350, height: 190 }
            %Image{ texture: "/Game/UI/Elements/#{artwork}.#{artwork}" }
          %TextBlock{ text: #{world_story.inspect}, size: "m", wrap: true }
        %VBox{ visible: #{page == 1}, spacing: 14 }
          %Select{ label: "#{t('menu.weather')}", value: #{weather_index}, options: #{weathers}, action: "weather.#{world_id}" }
          %Select{ label: "#{t('menu.time_of_day')}", value: #{time_index}, options: #{times}, action: "daytime.#{world_id}" }
          %Select{ label: "#{t('menu.season')}", value: #{season_index}, options: #{seasons}, action: "season.#{world_id}" }
          %Section{ title: "#{t('menu.wind')}", open: true }
            %Field{ label: "#{t('menu.direction')}" }
              %Slider{ value: #{wind_dir}, min: -180, max: 180, step: 5, unit: "°", action: "wind.dir", hint: #{wind_dir_hint.inspect} }
            %Field{ label: "#{t('menu.strength')}" }
              %Slider{ value: #{wind_speed}, min: 0, max: 5, step: 0.1, unit: "×", action: "wind.speed", hint: #{wind_speed_hint.inspect} }
            %Field{ label: "#{t('menu.gusts')}" }
              %Slider{ value: #{wind_gust}, min: 0, max: 8, step: 0.1, unit: "×", action: "wind.gust" }
            %Field{ label: "#{t('menu.randomness')}" }
              %Slider{ value: #{wind_random}, min: 0, max: 8, step: 0.1, unit: "×", action: "wind.random" }
            %Field{ label: "#{t('menu.thermals')}" }
              %Slider{ value: #{wind_thermal}, min: 0, max: 5, step: 0.1, unit: "×", action: "wind.thermal" }
            - if wind_custom
              %Button{ label: "#{t('menu.reset_wind')}", action: "wind.reset", tone: "dim" }
        %VBox{ visible: #{page == 2}, spacing: 12 }
          - launch_points.each_with_index do |point, index|
            %Button{ label: #{point.inspect}, action: "launch.#{index}", tone: "#{index == launch_index ? 'good' : 'dim'}" }
        - unless scenarios.empty?
          %VBox{ visible: #{page == 3}, spacing: 12 }
            %VBox{ spacing: 6 }
              %Button{ label: "#{t('menu.free_flight')}", action: "menu.scenario", value: 0, tone: "#{scenario_index == 0 ? 'good' : 'dim'}" }
              %TextBlock{ text: "#{t('menu.free_flight_hint')}", size: "s", wrap: true }
            - scenarios.each_with_index do |scen, scen_i|
              %VBox{ spacing: 6 }
                %Button{ label: "#{scen[:title]}", action: "menu.scenario", value: #{scen_i + 1}, tone: "#{scenario_index == scen_i + 1 ? 'good' : 'dim'}" }
                %TextBlock{ text: "#{scen[:story]}", size: "s", wrap: true }
      %HBox{ spacing: 12 }
        - if apply_mode
          %Button{ label: "#{fly_label}", action: "menu.applyChanges", tone: "good" }
        - else
          %Button{ label: #{fly_label.inspect}, action: "menu.#{world_id.downcase}", tone: "good" }