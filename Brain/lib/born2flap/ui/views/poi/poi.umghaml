%Overlay{ align: "center", valign: "center" }
  %Panel{ bg: "solid", padding: 20 }
    %VBox{ spacing: 6 }
      %Banner{ text: "#{t('poi.title')}", tone: "accent" }
      %TextBlock{ text: "#{t('poi.hint')}", tone: "dim", size: "xs", wrap: true }
      - pois.each_with_index do |p, i|
        %Button{ label: "#{p[:name]}", action: "poi.#{i}", tone: "#{p[:selected] ? 'good' : 'accent'}" }
      %Button{ label: "#{t('poi.close')}", action: "poi.close", tone: "dim" }
