%Overlay{ align: "center", valign: "center" }
  %Panel{ bg: "solid", padding: 40 }
    %VBox{ spacing: 12 }
      %Banner{ text: "#{t('brand')}", tone: "accent", size: "xxl" }
      %Progress{ value: #{splash_progress} }
      %TextBlock{ text: "#{t('splash.loading')}  #{splash_pct}%", tone: "dim", size: "s", align: "center" }
